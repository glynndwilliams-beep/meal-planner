rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
// Anyone signed in to the app can open a household only if they know its code;
// nobody can list or browse other households.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['meta', 'recipes', 'plans', 'shopping']
          && exists(/databases/$(database)/documents/households/$(code));
      }
    }
  }
}
